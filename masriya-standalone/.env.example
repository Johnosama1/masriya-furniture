# ============================================================
# المصرية للأثاث الراقي — Environment Variables
# ============================================================
# انسخ هذا الملف إلى .env وعدّل القيم:
#   cp .env.example .env
# ============================================================

# قاعدة البيانات PostgreSQL (مطلوب)
# مثال Neon:     postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# مثال Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# مثال محلي:     postgresql://postgres:password@localhost:5432/masriya
DATABASE_URL=postgresql://user:password@localhost:5432/masriya_furniture

# بيئة التشغيل
NODE_ENV=development

# منفذ الـ API (اختياري - الافتراضي 8080)
PORT=8080
