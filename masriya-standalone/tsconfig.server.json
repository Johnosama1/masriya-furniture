{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "server/dist",
    "rootDir": ".",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": ["server/src", "api"],
  "exclude": ["node_modules", "client", "server/dist"]
}
